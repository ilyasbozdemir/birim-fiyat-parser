{
  "name": "birim-fiyat-parser",
  "version": "1.0.0",
  "description": "PDF ve Web üzerinden birim fiyat tablolarını otomatik ayrıştırıcı",
  "main": "src/main.js",
  "homepage": "./",
  "author": "İlyas Bozdemir",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"pnpm run vite\" \"wait-on tcp:127.0.0.1:3000 && electron .\"",
    "start": "concurrently -k \"pnpm run vite\" \"wait-on tcp:127.0.0.1:3000 && electron .\"",
    "vite": "vite",
    "build": "vite build",
    "electron": "electron .",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "electron-is-dev": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^29.4.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.14",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ilyasbozdemir.birimfiyatparser",
    "productName": "Birim Fiyat Parser Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main.js",
      "src/preload.js",
      "python/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}